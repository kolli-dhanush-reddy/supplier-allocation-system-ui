# ─────────────────────────────────────────────────────────────
#  NexusFlow FastAPI Backend — Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# API key that all clients must send in the X-API-Key header
NOVA_API_KEY=your_api_key_here

# Allowed origins for CORS (comma-separated, no spaces)
# For local dev: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# App environment: development | production
APP_ENV=development

# Server host and port (used by uvicorn)
HOST=0.0.0.0
PORT=8000
